[{1 :luiscassih/AniMotion.nvim
  ; superseded by helix-keys.nvim, which owns w/b/e and d/c/y
  :enabled false
  :event :VeryLazy
  :opts {:color {:bg "#c9cbd0"} :mode :helix :edit_keys [:c :d :s :r :y :p]}}
 {1 :ggandor/leap.nvim
  :opts {}
  ; gw is Helix's goto-word jump
  :keys [{1 :gw 2 "<Plug>(leap)" :mode [:n :x :o]}]
  :event :VeryLazy}]
